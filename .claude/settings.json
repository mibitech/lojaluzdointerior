{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "Bash(supabase:*)",
      "Bash(npx playwright:*)",
      "Bash(xargs cat *)",
      "Bash(wc -l /c/Projetos/lojaamordapatria/src/pages/*.tsx)",
      "Bash(python -c ' *)",
      "Bash(python -)",
      "Bash(git check-ignore *)",
      "Bash(docker network *)",
      "Bash(ssh-add -l)",
      "Bash(docker version *)",
      "Bash(git remote *)",
      "Bash(node -e ' *)",
      "Bash(docker compose *)",
      "Bash(git rm *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(node -e \"JSON.parse\\(require\\('fs'\\).readFileSync\\('package.json','utf8'\\)\\); console.log\\('package.json valido'\\)\")",
      "Bash(grep -viE \"^\\\\s*$\")",
      "Bash(gh api *)",
      "Bash(curl -sS -o /dev/null -w \"manifest_anonimo=%{http_code}\\\\n\" --max-time 30 -H \"Accept: application/vnd.oci.image.index.v1+json\" \"https://ghcr.io/v2/mibitech/lojaamordapatria/manifests/latest\")"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && file=$(echo '$CLAUDE_TOOL_INPUT' | grep -oP '\"file_path\":\\s*\"\\K[^\"]+' | head -1) && case \"$file\" in *.ts|*.tsx) pnpm tsc --noEmit 2>&1 | grep -E '^src.*error TS' | head -5 ;; esac"
          }
        ]
      }
    ]
  }
}
